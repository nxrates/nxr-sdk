<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>NxrSdk</PackageId>
    <RootNamespace>NxRates.Sdk</RootNamespace>
    <AssemblyName>NxrSdk</AssemblyName>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Description>C# SDK for NX Rates -- REST and WebSocket streaming client.</Description>
  </PropertyGroup>

  <!-- MITCH wire format codec: https://github.com/nxrates/mitch/tree/main/impl/csharp -->
  <ItemGroup>
    <PackageReference Include="NxrMitch" Version="0.2.*" />
  </ItemGroup>

</Project>
